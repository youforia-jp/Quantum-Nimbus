# Nimbus IQ Configuration
PORT=8080
ENVIRONMENT=development

# Simulator Settings
DEFAULT_HEATING_TEMP=190.0

# Cryptographic Authentication Settings
NIMBUS_SIGNING_SECRET=your_signing_secret_here
ALLOW_UNVERIFIED_CARTRIDGES=false

# Supabase (required by netlify/functions/verify.ts) — same project as Private.
# Set these via `netlify dev` locally (.env, gitignored) and via the Netlify
# dashboard's Site settings > Environment variables for the deployed site.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
